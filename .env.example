# ==============================================================================
# Shortify Environment Configuration Template
# NOTE: Never commit sensitive credentials or production secrets to Git.
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=Shortify
BASE_URL=http://localhost:8000

# Server Binding
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shortify
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/shortify

# PostgreSQL Connection Pool Tuning
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=1800

# Redis Cache & Rate Limiting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_SECONDS=2.0
CACHE_TTL_SECONDS=3600
CACHE_FAIL_OPEN=true

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST_MULTIPLIER=1.5

# Observability & Monitoring
PROMETHEUS_METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
